datasource db {
   provider = "mongodb"
   url      = env("DATABASE_URL")
}

generator client {
   provider = "prisma-client-js"
}

/// <include path="./models/User.prisma"/>
/// <include path="./models/Worlds.prisma"/>
/// <include path="./models/WorldLike.prisma"/>
/// <include path="./models/WorldShape.prisma"/>
/// <include path="./models/Shape.prisma"/>
/// <include path="./models/RecentActivity.prisma"/>

enum AccessSpecifier {
   PRIVATE
   PUBLIC
}

type CanvasProperties {
   version    String
   objects    Json[]
   background String
}

enum ActionType {
   JOINED_WORLD
   LIKED_WORLD
   COMMENTED_WORLD
   UPVOTED_WORLD
}