model Worlds {
   id               String          @id @default(auto()) @map("_id") @db.ObjectId
   WorldName        String
   WorldDescription String
   WorldCoverImage  String
   AccessSpecifier  AccessSpecifier @default(PUBLIC)

   // Creator relationship
   CreatorId String @db.ObjectId
   Creator   User   @relation("WorldsCreator", fields: [CreatorId], references: [id])

   // Shapes in the world
   WorldShapes WorldShape[]

   // Timestamps
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   // Recent activity for this world
   // RecentActivity   RecentActivity[]

   // Likes for this world
   Likes WorldLike[]
}